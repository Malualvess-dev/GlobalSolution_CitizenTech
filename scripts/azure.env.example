# Copie para scripts/azure.env e preencha. O azure.env NAO vai para o Git.
# Usado por scripts/infra-azure.sh para criar os recursos e configurar a Web App.

# Nomes (opcionais). SUFIXO entra no nome dos recursos e precisa ser unico no Azure.
SUFIXO=paradacerta
LOCALIZACAO=brazilsouth
RESOURCE_GROUP=rg-paradacerta

# Oracle FIAP
DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
DB_USERNAME=rm000000
DB_PASSWORD=sua-senha-do-oracle
DDL_AUTO=validate

# RabbitMQ no Azure Container Instance (escolha um usuario e uma senha forte)
RABBITMQ_USERNAME=paradacerta
RABBITMQ_PASSWORD=troque-por-uma-senha-forte

# Segredos da API: no minimo 32 caracteres aleatorios cada
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais
HASH_SECRET=troque-por-outro-segredo-longo-e-aleatorio

# OpenAI (opcional: sem chave, o totem usa a frase padrao)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Primeiro gestor, criado na primeira vez que a API sobe
GESTOR_NOME="Gestor Parada Certa"
GESTOR_EMAIL=gestor@paradacerta.com
GESTOR_SENHA=troque-esta-senha

# Origens liberadas no CORS (* libera todas)
CORS_ALLOWED_ORIGINS="*"
